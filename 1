<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#1e4fa1">
<title>Ruleta Jugadon</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  html, body { height: 100%; overflow: hidden; }

  body {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #fff;
    background:
      radial-gradient(circle at 50% 12%, #3573e0 0%, #1e4fa1 34%, #142f66 66%, #0a1834 100%);
    user-select: none;
    -webkit-user-select: none;
  }

  body::before {
    content: "";
    position: fixed;
    inset: -20%;
    background:
      radial-gradient(circle at 18% 22%, rgba(255,255,255,.10) 0%, transparent 42%),
      radial-gradient(circle at 82% 78%, rgba(255,213,74,.10) 0%, transparent 45%);
    pointer-events: none;
  }

  .wrapper {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    padding: 18px;
    width: 100%;
  }

  /* ---------- RUEDA ---------- */
  .wheel-wrapper {
    position: relative;
    width: min(86vw, 84vh, 360px);
    aspect-ratio: 1 / 1;
  }

  .arrow {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 17px solid transparent;
    border-right: 17px solid transparent;
    border-top: 32px solid #ffd54a;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,.55));
    z-index: 6;
  }

  .arrow::after {
    content: "";
    position: absolute;
    top: -32px;
    left: -17px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff3c4, #ffd54a 55%, #d99b12);
    box-shadow: 0 3px 8px rgba(0,0,0,.45);
  }

  .wheel {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 8px solid #ffd54a;
    box-shadow:
      0 0 0 5px #0b1c40,
      0 0 0 9px rgba(255,213,74,.35),
      0 22px 46px rgba(0,0,0,.6),
      inset 0 0 40px rgba(0,0,0,.55);
    will-change: transform;
    transform: rotate(0deg);
  }

  .wheel-labels { position: absolute; inset: 0; }

  .wheel-label {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 7%;
    transform-origin: 50% 50%;
    pointer-events: none;
  }

  .wheel-label i {
    font-style: normal;
    font-size: clamp(20px, 6.4vw, 30px);
    line-height: 1;
    filter: drop-shadow(0 2px 3px rgba(0,0,0,.5));
  }

  .wheel-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 30%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 34% 28%, #ffffff 0%, #dfeaff 45%, #b9cef5 100%);
    box-shadow:
      0 0 0 5px #ffd54a,
      0 0 0 9px #0b1c40,
      0 8px 20px rgba(0,0,0,.5);
    z-index: 5;
  }

  .logo {
    font-weight: 900;
    font-size: clamp(9px, 2.9vw, 14px);
    letter-spacing: .5px;
    color: #1e4fa1;
    text-align: center;
    line-height: 1.05;
  }

  /* ---------- BOTÓN ---------- */
  .buttons { display: flex; justify-content: center; }

  #spinBtn {
    padding: 16px 54px;
    border: none;
    border-radius: 999px;
    background: linear-gradient(180deg, #ffe27a 0%, #ffd54a 45%, #f0a92a 100%);
    color: #12275a;
    font-weight: 900;
    font-size: 20px;
    letter-spacing: 1.5px;
    cursor: pointer;
    box-shadow:
      0 6px 0 #a8720f,
      0 14px 26px rgba(0,0,0,.45);
    transition: transform .1s ease, box-shadow .1s ease, filter .2s ease;
  }

  #spinBtn:active:not(:disabled) {
    transform: translateY(5px);
    box-shadow: 0 1px 0 #a8720f, 0 6px 14px rgba(0,0,0,.45);
  }

  #spinBtn:disabled {
    cursor: not-allowed;
    filter: grayscale(.55) brightness(.82);
    transform: translateY(4px);
    box-shadow: 0 2px 0 #a8720f, 0 8px 16px rgba(0,0,0,.4);
  }

  /* ---------- CARTEL RESULTADO ---------- */
  .slot-box {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(4, 10, 25, .78);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    opacity: 0;
    visibility: hidden;
    transition: opacity .25s ease, visibility .25s ease;
  }

  .slot-box.show { opacity: 1; visibility: visible; }

  .slot-inner {
    position: relative;
    width: min(88vw, 380px);
    padding: 36px 26px 32px;
    text-align: center;
    border-radius: 24px;
    border: 3px solid #ffd54a;
    background: linear-gradient(160deg, #2a63c4 0%, #1e4fa1 45%, #12275a 100%);
    box-shadow:
      0 0 0 6px rgba(11,28,64,.9),
      0 26px 60px rgba(0,0,0,.7);
    transform: scale(.75);
    opacity: 0;
    transition: transform .35s cubic-bezier(.2, 1.5, .45, 1), opacity .25s ease;
  }

  .slot-box.show .slot-inner { transform: scale(1); opacity: 1; }

  #slotTitle {
    display: block;
    font-size: clamp(21px, 6vw, 27px);
    font-weight: 900;
    letter-spacing: .5px;
    color: #ffd54a;
    text-shadow: 0 3px 10px rgba(0,0,0,.6);
    margin-bottom: 12px;
  }

  #slotValue {
    display: block;
    font-size: clamp(16px, 4.6vw, 21px);
    font-weight: 800;
    line-height: 1.3;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0,0,0,.6);
  }

  .close-btn {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(180deg, #ff5b8a, #e0245e);
    color: #fff;
    font-size: 24px;
    font-weight: 700;
    line-height: 36px;
    text-align: center;
    cursor: pointer;
    box-shadow: 0 5px 14px rgba(0,0,0,.55);
    transition: transform .15s ease;
  }

  .close-btn:active { transform: scale(.9); }

  @media (max-height: 560px) {
    .wrapper { gap: 18px; }
    #spinBtn { padding: 12px 42px; font-size: 17px; }
  }
</style>
</head>
<body>

  <div class="wrapper">
    <div class="wheel-wrapper">
      <div class="arrow"></div>
      <div id="wheel" class="wheel">
        <div id="wheelLabels" class="wheel-labels"></div>
      </div>
      <div class="wheel-center">
        <span class="logo">JUGADON</span>
      </div>
    </div>

    <div class="buttons">
      <button id="spinBtn" type="button">GIRAR</button>
    </div>
  </div>

  <div class="slot-box" id="slot">
    <div class="slot-inner">
      <span class="close-btn" id="closeBtn">×</span>
      <span id="slotTitle">¡FELICITACIONES!</span>
      <strong id="slotValue">¡GANASTE 50 TIROS GRATIS!</strong>
    </div>
  </div>

  <!-- Sonidos originales (servidos desde el repo en GitHub Pages) -->
  <audio id="spinSound" preload="auto"
    src="https://santimolina9.github.io/RuletaJugadon/assets/playful-casino-slot-machine-jackpot-3-183921.mp3"></audio>
  <audio id="winSound" preload="auto"
    src="https://santimolina9.github.io/RuletaJugadon/assets/coin-2seg.mp3"></audio>
  <audio id="loseSound" preload="auto"
    src="https://santimolina9.github.io/RuletaJugadon/assets/lose-sfx-365579.mp3"></audio>

<script>
(function () {
  'use strict';

  /* ======================= CONFIGURACIÓN ======================= */
  const SPIN_DURATION = 6;      // segundos
  const EXTRA_TURNS   = 6;      // vueltas mínimas extra
  const JITTER        = 0.32;   // desvío aleatorio dentro del sector

  const SEGMENTS = [
    { icon: '☹️', win: false },
    { icon: '🎊', win: true  },
    { icon: '🎉', win: true  },
    { icon: '🎊', win: true  },
    { icon: '☹️', win: false },
    { icon: '🎉', win: true  },
    { icon: '🎁', win: true  },
    { icon: '🎁', win: true  }
  ];

  const WIN_TITLE  = '¡FELICITACIONES!';
  const WIN_TEXT   = '¡GANASTE 50 TIROS GRATIS!';
  const LOSE_TITLE = '¡OH NO!';
  const LOSE_TEXT  = '¡SUERTE LA PRÓXIMA!';

  /* ======================= ELEMENTOS ======================= */
  const wheel       = document.getElementById('wheel');
  const wheelLabels = document.getElementById('wheelLabels');
  const spinBtn     = document.getElementById('spinBtn');
  const slot        = document.getElementById('slot');
  const slotTitle   = document.getElementById('slotTitle');
  const slotValue   = document.getElementById('slotValue');
  const closeBtn    = document.getElementById('closeBtn');

  const spinSound = document.getElementById('spinSound');
  const winSound  = document.getElementById('winSound');
  const loseSound = document.getElementById('loseSound');

  const N   = SEGMENTS.length;
  const SEG = 360 / N;

  /* ======================= CONSTRUCCIÓN ======================= */
  (function buildGradient() {
    const stops = [];
    for (let i = 0; i < N; i++) {
      const color = (i % 2 === 0) ? '#1e4fa1' : '#173b7a';
      stops.push(color + ' ' + (i * SEG) + 'deg ' + ((i + 1) * SEG) + 'deg');
    }
    wheel.style.background = 'conic-gradient(from 0deg, ' + stops.join(', ') + ')';
  })();

  SEGMENTS.forEach(function (seg, i) {
    const el = document.createElement('div');
    el.className = 'wheel-label';
    el.style.transform = 'rotate(' + (i * SEG + SEG / 2) + 'deg)';
    const icon = document.createElement('i');
    icon.textContent = seg.icon;
    el.appendChild(icon);
    wheelLabels.appendChild(el);
  });

  /* ======================= SONIDOS (los originales) ======================= */
  function safePlay(audio) {
    if (!audio) return;
    try {
      audio.pause();
      audio.currentTime = 0;
      var p = audio.play();
      if (p && typeof p.catch === 'function') p.catch(function () {});
    } catch (e) { /* ignorar */ }
  }

  function stopAudio(audio) {
    if (!audio) return;
    try { audio.pause(); audio.currentTime = 0; } catch (e) {}
  }

  function playSpinSound() { safePlay(spinSound); }
  function stopSpinSound() { stopAudio(spinSound); }
  function playWinSound()  { safePlay(winSound); }
  function playLoseSound() { safePlay(loseSound); }

  /* ======================= LÓGICA DE GIRO ======================= */
  let rotation = 0;
  let spinning = false;

  function showSlot() { slot.classList.add('show'); }
  function hideSlot() { slot.classList.remove('show'); }

  function finishSpin(winner) {
    // Detener el sonido del giro antes de reproducir el resultado
    stopSpinSound();

    const seg = SEGMENTS[winner];

    if (seg.win) {
      slotTitle.textContent = WIN_TITLE;
      slotValue.textContent = WIN_TEXT;
      playWinSound();
    } else {
      slotTitle.textContent = LOSE_TITLE;
      slotValue.textContent = LOSE_TEXT;
      playLoseSound();
    }

    showSlot();
    spinning = false;
    spinBtn.disabled = false;
    spinBtn.textContent = 'GIRAR';
  }

  function spin() {
    if (spinning) return;

    spinning = true;
    spinBtn.disabled = true;
    spinBtn.textContent = 'GIRANDO...';
    hideSlot();
    stopSpinSound();

    // 1) Sector ganador aleatorio
    const winner = Math.floor(Math.random() * N);

    // 2) Desvío aleatorio dentro del sector
    const jitter = (Math.random() * 2 - 1) * (SEG * JITTER);

    // 3) Rotación final
    const currentMod = ((rotation % 360) + 360) % 360;
    const desiredMod = (((360 - (winner * SEG + SEG / 2) + jitter) % 360) + 360) % 360;
    const delta      = (desiredMod - currentMod + 360) % 360;
    const turns      = EXTRA_TURNS + Math.floor(Math.random() * 3);
    const target     = rotation + turns * 360 + delta;

    // 4) Animación
    wheel.style.transition = 'transform ' + SPIN_DURATION + 's cubic-bezier(0.12, 0.72, 0.16, 1)';
    wheel.style.transform  = 'rotate(' + target + 'deg)';
    rotation = target;

    // 5) Sonido original de giro
    playSpinSound();

    // 6) Resultado
    setTimeout(function () {
      finishSpin(winner);
    }, SPIN_DURATION * 1000 + 200);
  }

  /* ======================= EVENTOS ======================= */
  spinBtn.addEventListener('click', spin);

  closeBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    hideSlot();
  });

  slot.addEventListener('click', function (e) {
    if (e.target === slot) hideSlot();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') hideSlot();
    if (e.key === ' ' && !spinning) { e.preventDefault(); spin(); }
  });

  // Desbloqueo de audio en primer toque (iOS / Android)
  document.addEventListener('touchstart', function unlock() {
    [spinSound, winSound, loseSound].forEach(function (a) {
      try { a.load(); } catch (e) {}
    });
    document.removeEventListener('touchstart', unlock);
  }, { once: true });

})();
</script>
</body>
</html>
